import { useState, useRef } from "react";
import { runTest, LOCAL_TEST_CONFIG } from "./engine/index.js";

/**
 * Deliberately ugly. This is a harness, not the product — its job is to get
 * the engine into the bundle, prove it works over a real network, and hand
 * you the result JSON. The actual UI comes later.
 */
export default function App() {
  const [phase, setPhase] = useState("idle");
  const [live, setLive] = useState(null);
  const [result, setResult] = useState(null);
  const [error, setError] = useState(null);
  const abortRef = useRef(null);

  const start = async (small) => {
    setResult(null);
    setError(null);
    setLive(null);

    const controller = new AbortController();
    abortRef.current = controller;

    try {
      const r = await runTest({
        signal: controller.signal,
        overrides: small ? LOCAL_TEST_CONFIG : undefined,
        onPhase: setPhase,
        onSample: (s) => {
          if (s.mbps !== undefined) setLive(s);
        }
      });
      setResult(r);
    } catch (e) {
      setError(String(e));
    } finally {
      setPhase("idle");
    }
  };

  const running = phase !== "idle";

  return (
    <div style={S.page}>
      <h1 style={S.h1}>Speed test harness</h1>

      <div style={S.row}>
        <button style={S.btn} disabled={running} onClick={() => start(true)}>
          Quick run
        </button>
        <button style={S.btn} disabled={running} onClick={() => start(false)}>
          Full run
        </button>
        <button
          style={S.btn}
          disabled={!running}
          onClick={() => abortRef.current?.abort()}
        >
          Stop
        </button>
      </div>

      <div style={S.status}>
        phase: <b>{phase}</b>
        {live && (
          <span style={{ marginLeft: 16 }}>
            {live.phase}: <b>{live.mbps.toFixed(1)} Mbps</b>
          </span>
        )}
      </div>

      {error && <pre style={S.err}>{error}</pre>}

      {result && (
        <>
          <div style={S.row}>
            <button
              style={S.btn}
              onClick={() =>
                navigator.clipboard.writeText(JSON.stringify(result, null, 2))
              }
            >
              Copy JSON
            </button>
          </div>

          <div style={S.summary}>{result.summary}</div>

          <div style={S.grid}>
            <Stat label="Download" value={`${result.download} Mbps`} />
            <Stat label="Upload" value={`${result.upload} Mbps`} />
            <Stat label="Latency (idle)" value={`${result.latency.idle} ms`} />
            <Stat label="Latency (loaded)" value={`${result.latency.loaded} ms`} />
            <Stat label="Jitter" value={`${result.latency.jitter} ms`} />
            <Stat
              label="Bufferbloat"
              value={`${result.bufferbloat.grade} (+${result.bufferbloat.increaseMs.toFixed(0)} ms)`}
            />
          </div>

          <ul style={S.verdicts}>
            {result.verdicts.map((v) => (
              <li key={v.name} style={{ color: v.ok ? "#4ade80" : "#f87171" }}>
                {v.ok ? "PASS" : "FAIL"} — {v.name}{" "}
                <span style={{ color: "#64748b" }}>({v.detail})</span>
              </li>
            ))}
          </ul>

          <pre style={S.json}>{JSON.stringify(result, null, 2)}</pre>
        </>
      )}
    </div>
  );
}

function Stat({ label, value }) {
  return (
    <div style={S.stat}>
      <div style={S.statLabel}>{label}</div>
      <div style={S.statValue}>{value}</div>
    </div>
  );
}

const S = {
  page: {
    minHeight: "100vh",
    background: "#020617",
    color: "#e2e8f0",
    fontFamily: "ui-monospace, Menlo, monospace",
    padding: 32
  },
  h1: { fontSize: 20, fontWeight: 600, marginBottom: 20 },
  row: { display: "flex", gap: 8, marginBottom: 16 },
  btn: {
    background: "#1e293b",
    color: "#e2e8f0",
    border: "1px solid #334155",
    borderRadius: 6,
    padding: "8px 14px",
    cursor: "pointer",
    fontFamily: "inherit",
    fontSize: 13
  },
  status: { fontSize: 13, color: "#94a3b8", marginBottom: 16 },
  err: {
    background: "#450a0a",
    color: "#fca5a5",
    padding: 12,
    borderRadius: 6,
    fontSize: 12
  },
  summary: {
    fontSize: 14,
    color: "#cbd5e1",
    marginBottom: 16,
    padding: 12,
    background: "#0f172a",
    borderRadius: 6
  },
  grid: {
    display: "grid",
    gridTemplateColumns: "repeat(auto-fit, minmax(160px, 1fr))",
    gap: 10,
    marginBottom: 20
  },
  stat: { background: "#0f172a", borderRadius: 6, padding: 12 },
  statLabel: { fontSize: 11, color: "#64748b", marginBottom: 4 },
  statValue: { fontSize: 18, fontWeight: 600 },
  verdicts: { fontSize: 13, lineHeight: 1.8, marginBottom: 20, paddingLeft: 18 },
  json: {
    background: "#0f172a",
    padding: 14,
    borderRadius: 6,
    fontSize: 11,
    lineHeight: 1.5,
    maxHeight: 360,
    overflow: "auto",
    color: "#94a3b8"
  }
};
